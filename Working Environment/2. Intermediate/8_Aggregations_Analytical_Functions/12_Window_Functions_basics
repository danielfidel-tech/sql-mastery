-- SQL Task 6: Find total sales across all order as well as for each product plus order id & order date
-- Step 1: View table
SELECT *
FROM sales.orders;

-- Step 2: Total for all orders, total sales per product plus including order id & order date
SELECT
    orderid,
    orderdate,
    SUM(sales) OVER () AS total_sales,
    SUM(sales) OVER (PARTITION BY productid) AS total_sales_per_product
